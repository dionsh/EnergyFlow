# Copy to backend/.env for local development. Never commit the real .env.
# On Render these are set as environment variables (see render.yaml / DEPLOY.md).

APP_ENV=local
APP_DEBUG=1
# 64 hex chars. Root of the derived per-device secrets — changing it re-keys every device.
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Local XAMPP MariaDB (root, no password). On Aiven: host, port (NOT 3306), user avnadmin.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=energyflow
DB_USER=root
DB_PASS=

# TLS for Aiven. Locally leave empty. On Render paste the Aiven CA certificate into
# DB_SSL_CA_CONTENT. DB_SSL_CA is a file path alternative for running tools locally against Aiven.
DB_SSL_CA=
DB_SSL_CA_CONTENT=
DB_SSL=0

# Must be 0 for plain-http local development, or the browser drops the session cookie.
SESSION_SECURE=0
SESSION_TTL_DAYS=7

# Password reset links. Local reset URLs are printed in the backend terminal.
FRONTEND_URL=http://localhost:5173
# Optional email delivery through Resend (required for production password resets).
RESEND_API_KEY=
MAIL_FROM=

# Shared secret for the cron-job.org call to /api/v1/internal/jobs/run.
CRON_SECRET=change-me-local

# AI assistant (Groq). Leave empty and the assistant answers from data only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used when the main model is rate-limited or down (separate free-tier limits).
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Model-written assistant answers per company per day (data answers don't count).
# ASSISTANT_DAILY_LIMIT=200
# Camera scan: the vision model that reads bills, meters, nameplates, receipts and labels,
# and how many photos a company may have read per day.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# SCAN_DAILY_LIMIT=100

# Optional: the real on-stage node for the demo company (tools/hw-bridge + a metering smart plug).
# Only set this when you actually have the hardware. Every demo reset then adds the device
# "LIVE-01 Workshop lamp" mapped to this serial; get its secret with:
#   php bin/provision-device.php --company=demo --serial=EF-101 --machine=LIVE-01 --relay
# DEMO_HARDWARE_SERIAL=EF-101
