# Copy to backend/.env for local development. Never commit the real .env.
# On Render these are set as environment variables (see render.yaml / DEPLOY.md).

APP_ENV=local
APP_DEBUG=1

# Local XAMPP MariaDB (root, no password). On Aiven: host, port (NOT 3306), user avnadmin.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=energyflow
DB_USER=root
DB_PASS=

# TLS for Aiven. Locally leave empty. On Render paste the Aiven CA certificate into
# DB_SSL_CA_CONTENT. DB_SSL_CA is a file path alternative for running tools locally against Aiven.
DB_SSL_CA=
DB_SSL_CA_CONTENT=
DB_SSL=0

# Must be 0 for plain-http local development, or the browser drops the session cookie.
SESSION_SECURE=0
SESSION_TTL_DAYS=7

# Shared secret for the cron-job.org call to /api/v1/internal/jobs/run.
CRON_SECRET=change-me-local

# AI assistant (Groq). Leave empty and the assistant answers from data only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
