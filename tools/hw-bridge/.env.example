# Copy to .env (never commit it). The secret comes from:
#   php backend/bin/provision-device.php --company=demo --serial=EF-101 --machine=LIVE-01 --relay

# The EnergyFlow API. Devices call the API host directly (not through Vercel).
EF_API_URL=http://127.0.0.1:8000
EF_DEVICE_SERIAL=EF-101
EF_DEVICE_SECRET=

# Which channel of the device this plug is (matches the provisioning, default 1).
EF_CHANNEL=1

# shelly-gen2 (a real Shelly Gen2+ metering plug on the same LAN) or mock (development only, needs --dev-mock).
EF_PLUG_DRIVER=shelly-gen2
EF_PLUG_HOST=192.168.1.50

# Uplink interval in seconds (EF-N3 firmware uses 10 s).
EF_INTERVAL_S=10
