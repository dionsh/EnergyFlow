# Optional. By default the app calls /api/v1 on its own origin
# (Vite proxies it locally, Vercel rewrites it to Render in production).
# Only set this to call the API directly, e.g. VITE_API_URL=https://energyflow-api.onrender.com/api/v1
VITE_API_URL=

# Optional. Public contact address shown on the landing page (contact section and footer).
# Leave empty and no address is shown. On Vercel: Settings → Environment Variables, then redeploy.
VITE_CONTACT_EMAIL=
